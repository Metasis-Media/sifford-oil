# Canonical site URL used for metadata, sitemap and JSON-LD.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Request forms email the shop through Resend (https://resend.com).
# Without these, forms tell visitors to call instead (in production) or log to the console (in dev).
RESEND_API_KEY=
# One or more addresses, comma separated.
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL="Sifford Oil Website <website@example.com>"
